{
  "manifest_version": 3,
  "name": "TrueDate for LinkedIn",
  "version": "0.1.0",
  "description": "Surfaces true post date on LinkedIn job postings.",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/big_icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/big_icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/search/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.linkedin.com/jobs/search/*"],
      "js": ["content.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["globals.css"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
