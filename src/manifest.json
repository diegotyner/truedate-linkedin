{
  "manifest_version": 3,
  "name": "TrueDate for LinkedIn",
  "version": "0.1.0",
  "description": "Surfaces true post date and applicant count on LinkedIn job postings.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "css": ["globals.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
