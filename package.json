{
  "name": "truedate-linkedin",
  "version": "1.0.0",
  "description": "A chrome extension to show original job posting dates",
  "homepage": "https://github.com/diegotyner/truedate-linkedin#readme",
  "bugs": {
    "url": "https://github.com/diegotyner/truedate-linkedin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegotyner/truedate-linkedin.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "watch:js": "node esbuild.config.js --watch",
    "build:js": "node esbuild.config.js",
    "watch:css": "npx @tailwindcss/cli -i src/globals.css -o dist/globals.css --watch",
    "build:css": "npx @tailwindcss/cli -i src/globals.css -o dist/globals.css --minify",
    "copy:static": "cp src/manifest.json dist/manifest.json && cp -r src/icons dist/",
    "dev": "npm-run-all --parallel watch:js watch:css",
    "build": "npm run build:js && npm run build:css && npm run copy:static",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "chrome-types": "^0.1.436",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.28.1": true
  }
}
